<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mk_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:text="@string/brand_line"
        android:textColor="@color/mk_text_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:text="00:00"
        android:textColor="@color/mk_text"
        android:textSize="44sp" />

    <Button
        android:id="@+id/btn_record"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="@string/record"
        android:textColor="@color/mk_bg"
        android:textSize="16sp"
        android:background="@color/mk_accent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mk_surface" />

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/mk_surface"
        android:dividerHeight="1dp"
        android:cacheColorHint="@android:color/transparent"
        android:listSelector="@color/mk_surface_hi" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/empty_hint"
        android:textColor="@color/mk_text_dim"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
